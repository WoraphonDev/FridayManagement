<?xml version="1.0" encoding="UTF-8"?>
<!-- Operator imports and enables explicitly AFTER a manual backup/restore rehearsal.
     SYSTEM is opt-in local elevation to stop/start SCM; DB role stays backup-only.
     Protect all executables/source/config/parent paths from non-admin writes. -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>Friday isolated staging backup, daily 02:00 local time. Failure leaves application stopped for operator review.</Description></RegistrationInfo>
  <Triggers><CalendarTrigger><StartBoundary>2026-01-01T02:00:00</StartBoundary><Enabled>true</Enabled><ScheduleByDay><DaysInterval>1</DaysInterval></ScheduleByDay></CalendarTrigger></Triggers>
  <Principals><Principal id="Operator"><UserId>S-1-5-18</UserId><LogonType>ServiceAccount</LogonType><RunLevel>HighestAvailable</RunLevel></Principal></Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>false</StartWhenAvailable>
    <Enabled>false</Enabled>
    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
  </Settings>
  <Actions Context="Operator"><Exec>
    <Command>C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Command>
    <Arguments>-NoLogo -NoProfile -NonInteractive -File "C:\FridaySource\scripts\windows\Backup-Friday.ps1" -EnvironmentFile "C:\FridayStage\private\backup.env" -NodePath "C:\FridayRuntime\node.exe" -PostgresBin "C:\Program Files\PostgreSQL\17\bin" -BackupRoot "C:\FridayStage\backups" -ServiceName "FridayStaging" -ConfirmStopApplication</Arguments>
    <WorkingDirectory>C:\FridaySource</WorkingDirectory>
  </Exec></Actions>
</Task>
