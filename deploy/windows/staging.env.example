# Reference only; copy OUTSIDE checkout and restrict DACL before setting secrets.
# No .env is auto-loaded. This profile never authorizes production.
NODE_ENV=test
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://friday.example.test
COOKIE_SECURE=true
TRUSTED_PROXY=127.0.0.1
DB_PROVIDER=postgres
DB_SERVER=127.0.0.1
DB_PORT=5432
DB_NAME=friday_staging
DB_USER=friday_stage_app
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=false
DATA_DIR=C:\FridayStage\data
LOG_DIR=C:\FridayStage\logs
# owner.env: DB_USER=friday_stage_owner (migration/restore only)
# backup.env: DB_USER=friday_stage_backup (backup only)
# restore.env: owner credentials, separate DB_NAME=friday_restore_staging,
# separate empty DATA_DIR/LOG_DIR, PORT=3001, APP_ORIGIN=https://restore.example.test
# and FRIDAY_RESTORE_SOURCE=C:\FridayStage\backups\<verified-snapshot>
