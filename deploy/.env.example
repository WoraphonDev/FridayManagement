# Copy to deploy/.env (never commit it). All values are placeholders.
FRIDAY_HOST=friday.example.org
# e-mail for Let's Encrypt on a public host, or "internal" for a rehearsal certificate
FRIDAY_TLS=admin@example.org
DB_NAME=friday
# Four separate PostgreSQL roles (RV-18). Generate each password with: openssl rand -hex 24
# Superuser "postgres": bootstrap and operator psql only; never given to the app or tools.
DB_ADMIN_PASSWORD=change-me-admin
# Schema owner: migrate and restore only.
DB_OWNER_USER=friday_owner
DB_OWNER_PASSWORD=change-me-owner
# Runtime application: row read/write, cannot change the schema.
DB_USER=friday_app
DB_PASSWORD=change-me-app
# Backup/verify: read-only plus the maintenance freeze row.
DB_BACKUP_USER=friday_backup
DB_BACKUP_PASSWORD=change-me-backup
HTTPS_PORT=443
HTTP_PORT=80
# Public origin when HTTPS is not on 443 (rehearsal), e.g. https://friday.localhost:8443
# FRIDAY_ORIGIN=
