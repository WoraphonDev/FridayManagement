{
  "name": "friday-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.3 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "build:contract": "node scripts/build-contract.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "test:contract": "node --test tests/contracts/*.test.mjs",
    "build:test-plan": "node scripts/build-test-manifest.mjs",
    "check:test-plan": "node scripts/check-test-plan.mjs",
    "test:test-plan": "node --test tests/planning/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/check-runtime.mjs && tsc -p tsconfig.json && vite build --config vite.config.ts",
    "start": "node scripts/check-runtime.mjs && node dist/server/api/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.frontend.json && tsc -p tsconfig.tools.json",
    "lint": "eslint src frontend/src scripts/*.ts vite.config.ts vitest.config.ts playwright.config.ts tests/foundation tests/sqlserver tests/browser tests/config tests/schema tests/helpers tests/api tests/idempotency tests/authorization tests/setup tests/sessions tests/accounts tests/admin-cli tests/workspaces tests/tasks tests/task-views tests/boards tests/files tests/notifications tests/permissions tests/operations tests/regression tests/performance tests/addendum",
    "format": "prettier --write src frontend scripts/*.ts vite.config.ts vitest.config.ts tests/foundation",
    "test": "npm run test:config && npm run test:foundation && npm run test:schema && npm run test:helpers && npm run test:api && npm run test:idempotency && npm run test:authorization && npm run test:setup && npm run test:sessions && npm run test:accounts && npm run test:admin-cli && npm run test:workspaces && npm run test:tasks && npm run test:task-views && npm run test:boards && npm run test:files && npm run test:notifications && npm run test:permissions && npm run test:addendum && npm run test:frontend && npm run test:contract && npm run test:test-plan && npm run test:operations && npm run test:regression && npm run test:performance-policy",
    "test:foundation": "node --import tsx --test tests/foundation/*.test.ts",
    "test:frontend": "vitest run --config vitest.config.ts",
    "test:sqlite": "npm run test:foundation",
    "test:sqlserver": "node --import tsx --test tests/sqlserver/*.test.ts",
    "test:ui": "playwright test",
    "migrate:sqlite": "node --import tsx scripts/migrate.ts sqlite",
    "migrate:sqlserver": "node --import tsx scripts/migrate.ts sqlserver",
    "sample-data:sqlite": "node --import tsx scripts/sample-data.ts",
    "licenses": "node scripts/licenses.mjs",
    "verify:checkout": "node scripts/verify-fresh-checkout.mjs",
    "test:config": "node --import tsx --test tests/config/*.test.ts",
    "test:schema": "node --import tsx --test tests/schema/*.test.ts",
    "test:helpers": "node --import tsx --test tests/helpers/*.test.ts",
    "test:api": "node --import tsx --test tests/api/*.test.ts",
    "test:idempotency": "node --import tsx --test tests/idempotency/*.test.ts",
    "test:authorization": "node --import tsx --test tests/authorization/*.test.ts",
    "test:setup": "node --import tsx --test tests/setup/*.test.ts",
    "test:sessions": "node --import tsx --test tests/sessions/*.test.ts",
    "test:accounts": "node --import tsx --test tests/accounts/*.test.ts",
    "admin": "node scripts/check-runtime.mjs && node dist/server/cli/main.js",
    "test:admin-cli": "node --import tsx --test tests/admin-cli/*.test.ts",
    "test:workspaces": "node --import tsx --test tests/workspaces/*.test.ts",
    "test:tasks": "node --import tsx --test tests/tasks/*.test.ts",
    "test:task-views": "node --import tsx --test tests/task-views/*.test.ts",
    "test:files": "node --import tsx --test tests/files/*.test.ts",
    "test:boards": "node --import tsx --test tests/boards/*.test.ts",
    "test:notifications": "node --import tsx --test tests/notifications/*.test.ts",
    "test:permissions": "node --import tsx --test tests/permissions/*.test.ts",
    "test:addendum": "node --import tsx --test tests/addendum/*.test.ts",
    "ops": "node scripts/check-runtime.mjs && node dist/server/operations/main.js",
    "test:operations": "node --import tsx --test tests/operations/*.test.ts",
    "test:regression": "node --import tsx --test tests/regression/*.test.ts",
    "performance": "node scripts/check-runtime.mjs && node --import tsx scripts/performance.ts",
    "test:performance-policy": "node --import tsx --test tests/performance/*.test.ts",
    "performance:memory": "node scripts/check-runtime.mjs && node --expose-gc --import tsx scripts/performance.ts",
    "check:sqlserver": "node scripts/check-runtime.mjs && node --import tsx scripts/check-sqlserver.ts",
    "test:sqlserver:foundation": "npm run check:sqlserver && node --import tsx --test --test-concurrency=1 tests/sqlserver/config.test.ts tests/sqlserver/schema.test.ts tests/sqlserver/foundation.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/busboy": "1.5.4",
    "@types/express": "5.0.6",
    "@types/mssql": "12.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/nunito": "5.3.0",
    "@vibe/core": "4.5.34",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "busboy": "1.6.0",
    "express": "5.2.1",
    "mssql": "12.7.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tedious": "20.3.3",
    "zod": "4.6.5"
  }
}
