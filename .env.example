# Reference only. Do not put real secrets in this file.
# T-006 validates these keys before startup. Keep real config/secrets outside source.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
DB_PROVIDER=sqlite
# Absolute, writable paths outside source/build/webroot. Required even for shell startup.
DATA_DIR=
LOG_DIR=
SQLITE_DB_PATH=
DB_SERVER=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_POOL_MAX=10
DB_REQUEST_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_BACKUP_DIR=
MAX_FILE_BYTES=10485760
TOTAL_UPLOAD_BYTES=5368709120
SESSION_ABSOLUTE_MIN=720
SESSION_IDLE_MIN=60
POLL_SECONDS=5
REMINDER_SECONDS=60
TRASH_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90
TRUSTED_PROXY=
# Proxy list accepts comma-separated exact IP addresses only, not '*' or hop counts.
# SQL backup directory belongs to the SQL host; app does not create/probe it locally.
